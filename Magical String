class Solution {
    public int magicalString(int n) {
        if (n <= 0) return 0;
        if (n <= 3) return 1; // For n = 1, 2, 3, "122" contains only one '1'

        int[] s = new int[n + 1];
        // Initial prefix: "122"
        s[0] = 1;
        s[1] = 2;
        s[2] = 2;

        int head = 2;  // Pointer for group size
        int tail = 3;  // Pointer for generating the next character
        int num = 1;   // The next character to append (toggles between 1 and 2)
        int count1 = 1; // '1's in "122"

        while (tail < n) {
            int times = s[head]; // How many copies of `num` to append
            
            while (times > 0 && tail < n) {
                s[tail] = num;
                if (num == 1) {
                    count1++;
                }
                tail++;
                times--;
            }

            num = 3 - num; // Toggle between 1 and 2 (3 - 1 = 2, 3 - 2 = 1)
            head++;        // Move to the next group size index
        }

        return count1;
    }
}
